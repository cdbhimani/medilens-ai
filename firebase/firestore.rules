rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile access strictly scoped to the authenticated user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reports and analysis records strictly isolated by owner
    match /reports/{reportId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid);
    }

    // Curated medical knowledge is read-only to authenticated users
    match /medicalKnowledge/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Read-only collection
    }
  }
}
