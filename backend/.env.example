# ===================================================================
# MediLens AI — Environment Configuration Template
# ===================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Firebase Configuration (Optional: for cloud token verification and Firestore)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Frontend Origin for CORS (Production)
FRONTEND_URL=https://your-medilens-app.web.app
